# 로컬: 이 파일을 .streamlit/secrets.toml 로 복사해 값을 채운다 (git 에 올라가지 않음)
# 배포: Streamlit Cloud → 앱 Settings → Secrets 에 같은 내용을 붙여넣는다

LLM_PROVIDER = "gemini"          # "gemini" | "claude"
GEMINI_API_KEY = "여기에_키"      # https://aistudio.google.com/apikey  (비워 두면 방문자가 자기 키 입력)
# ANTHROPIC_API_KEY = ""

# 운영자 키 사용 시 남용 방지
MAX_QUESTIONS_PER_SESSION = 20
GLOBAL_QUESTIONS_PER_MINUTE = 3

# 데이터 출처 (core/datasource.py). 없으면 저장소의 parquet 를 읽는다.
# APP_DATABASE_URL 은 읽기 전용 계정(app_reader)의 Session pooler 접속 문자열을 넣는다. 관리자(postgres) 계정은 넣지 않는다.
# APP_DATABASE_URL = "postgresql://app_reader.<프로젝트ID>:<비밀번호>@<리전>.pooler.supabase.com:5432/postgres"
# APP_DATA_SOURCE = "auto"       # auto(기본: DB 실패 시 parquet) | db | parquet
