# 로컬 설정 예시. 실제 값은 Git 제외 .env에만 저장합니다.
GH_TOKEN=

# 공유 DB: Bigdata_platform / uoiamnbkzlvlskngataq (ap-southeast-2)
# Session pooler: aws-0-ap-southeast-2.pooler.supabase.com:5432
# 앱 DB 읽기와 pipeline.load_supabase가 사용하는 키입니다.
# 조회 작업에는 읽기 전용 계정, 운영 적재 담당자는 승인된 쓰기 계정을 설정합니다.
# 프로세스 환경변수에 같은 키가 있으면 .env보다 우선하므로 대상도 확인합니다.
# 접속 정보는 관리자가 각 PC에 별도로 제공해야 합니다. 빈 값으로는 DB 작업을 하지 않습니다.
APP_DATABASE_URL=

# 선택: 관리자 PC에 적재용 URL과 구분해 보관하는 읽기 전용 URL.
# 이 키만 설정해도 앱/적재 스크립트가 자동으로 읽는 것은 아닙니다.
APP_READER_DATABASE_URL=
